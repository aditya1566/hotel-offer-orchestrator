{
  "name": "hotel-offer-orchestrator",
  "version": "1.0.0",
  "description": "Aggregates hotel offers from two suppliers with Temporal, dedupes by name, picks the best price, and filters by price inside Redis.",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node dist/scripts/bundle-workflows.js",
    "start:api": "node dist/server.js",
    "start:worker": "node dist/temporal/worker.js",
    "dev:api": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/temporal/worker.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:postman": "newman run postman/hotel-offer-orchestrator.postman_collection.json -e postman/local.postman_environment.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docker:up": "docker compose up --build -d --wait",
    "docker:down": "docker compose down -v",
    "docker:logs": "docker compose logs -f api worker"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@temporalio/activity": "1.26.0",
    "@temporalio/client": "1.26.0",
    "@temporalio/common": "1.26.0",
    "@temporalio/worker": "1.26.0",
    "@temporalio/workflow": "1.26.0",
    "express": "^5.3.0",
    "ioredis": "^5.11.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@temporalio/testing": "1.26.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "newman": "^6.2.3",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vitest": "^3.2.7"
  },
  "private": true,
  "engines": {
    "node": ">=20.10"
  }
}
