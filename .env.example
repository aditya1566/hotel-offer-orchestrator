# Copy to .env to override defaults (docker compose reads .env automatically).
# All values below are the defaults.

# --- Ports published on the host (docker compose) ---
API_PORT=3000
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8233
REDIS_PORT=6379

# --- Application ---
LOG_LEVEL=info                      # trace | debug | info | warn | error | silent
CACHE_TTL_SECONDS=60                # freshness of a complete snapshot in Redis
PARTIAL_CACHE_TTL_SECONDS=10        # freshness when a supplier failed (retry it sooner)
SUPPLIER_TIMEOUT_MS=3000            # per-attempt HTTP timeout to a supplier
WORKFLOW_TIMEOUT_MS=20000           # max time the API waits for a workflow run
ENABLE_SUPPLIER_SIMULATION=true     # /admin/suppliers/* fault-injection endpoints

# --- Only needed when running outside docker compose (npm run dev:*) ---
# PORT=3000
# REDIS_URL=redis://localhost:6379
# REDIS_KEY_PREFIX=hoo:
# TEMPORAL_ADDRESS=localhost:7233
# TEMPORAL_NAMESPACE=default
# TEMPORAL_TASK_QUEUE=hotel-offers
# SUPPLIER_A_URL=http://localhost:3000/supplierA/hotels
# SUPPLIER_B_URL=http://localhost:3000/supplierB/hotels
# HEALTH_CHECK_TIMEOUT_MS=2000
# LOG_PRETTY=true                   # human-readable logs in dev (needs dev deps)
